NEXT_PUBLIC_SITE_URL=https://www.hiflight.fr
NEXT_PUBLIC_SEARCH_URL=https://vols.hiflight.fr
# Google Tag Manager orchestre les balises Google après acceptation du bandeau.
NEXT_PUBLIC_GTM_ID=GTM-NN5ZTFT2
NEXT_PUBLIC_GA_ID=G-22R2R3YL8M
# Ces identifiants restent inactifs tant qu'ils ne sont pas configurés dans Vercel.
# Les balises ne se chargent qu'après acceptation du bandeau de confidentialité.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Compte utilisateur partagé entre le site et l’application HiFlight.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Identifiants serveur Travelpayouts. Ne jamais les préfixer par NEXT_PUBLIC_.
# TP_TOKEN est le nom utilisé dans Vercel. TRAVELPAYOUTS_TOKEN reste accepté comme alias.
TP_TOKEN=
TP_MARKER=
TRAVELPAYOUTS_TOKEN=

# Stay22 affiche la carte hôtelière réelle dès que l'AID est renseigné.
# STAY22_AID est lu côté serveur et recommandé. L'ancien nom public reste accepté.
STAY22_AID=
NEXT_PUBLIC_STAY22_AID=

# Réservé à la future Direct Travel API Stay22, actuellement fermée aux nouveaux accès.
STAY22_API_KEY=

# Liens profonds affiliés générés dans Stay22, Awin, CJ ou Effinity.
# Les modèles acceptent : {destination}, {checkin}, {checkout}, {guests},
# {pickup}, {pickupDate}, {returnDate} et {driverAge}.
NEXT_PUBLIC_BOOKING_AFFILIATE_URL=
NEXT_PUBLIC_EXPEDIA_AFFILIATE_URL=
NEXT_PUBLIC_TRIP_AFFILIATE_URL=
NEXT_PUBLIC_HOTELS_AFFILIATE_URL=
NEXT_PUBLIC_RENTALCARS_AFFILIATE_URL=
NEXT_PUBLIC_DISCOVERCARS_AFFILIATE_URL=
NEXT_PUBLIC_EXPEDIA_CARS_AFFILIATE_URL=
NEXT_PUBLIC_VIPCARS_AFFILIATE_URL=
NEXT_PUBLIC_FLIXBUS_AFFILIATE_URL=
